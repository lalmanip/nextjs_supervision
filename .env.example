# User service (vivapi-user)
USER_REPO_URL=http://127.0.0.1

# MT service (vivapi-mt) — base URL only; e.g. full path http://localhost:8080/vivapi-mt/rest/get-agency-balance
MT_REPO_URL=http://localhost:8080

# Holidays service — base URL (BFF calls POST {HOLIDAYS_API_URL}/api/v1/holidays/admin/packages)
HOLIDAYS_API_URL=http://127.0.0.1:8095
# Public origin for uploaded holiday images (returned in heroImageUrl / imageUrl). Usually same host as HOLIDAYS_API_URL.
# HOLIDAY_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8095

# Auth service (vivapi-auth) — app login for gateway Bearer + typically X-API-KEY for user APIs
AUTH_URL=http://localhost:8084
VIV_X_API_KEY="viv-8806f318-1ecf-11ee-b64f-36e9be0141c6"

# Body for POST {AUTH_URL}/vivapi-auth/app/auth/login
AUTH_APP_DOMAIN_KEY=TMX5193291565602439
AUTH_APP_USERNAME=test229267
AUTH_APP_PASSWORD=test@229
AUTH_APP_SYSTEM=test

# Dev/staging ribbon — required for "TEST ENV" banner (omit or set production on prod)
APP_ENVIRONMENT=dev

# Troubleshooting: log API requests/responses (secrets redacted in output)
# Server Route Handlers (terminal / server logs)
# SUPERVISION_API_DEBUG=true
# Browser: shared Axios client (src/services/http)
# NEXT_PUBLIC_SUPERVISION_API_DEBUG=true